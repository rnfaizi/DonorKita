# Salin ke .env lalu isi nilainya. File .env TIDAK BOLEH di-commit.
# Buat secret dengan:  openssl rand -hex 32

# ===== Rahasia bersama core dan auth (wajib diisi) =====
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
INTERNAL_TOKEN=ganti-dengan-hasil-openssl-rand-hex-16

# ===== Akun admin awal (dibuat otomatis saat auth start) =====
ADMIN_EMAIL=admin@donorkita.test
ADMIN_PASSWORD=ganti-password-admin

# ===== Data uji untuk demo dan kelompok lain =====
# Fasilitas, stok, kegiatan donor "Uji" (core) + akun pendonor/pemohon/petugas@demo.test (auth)
SEED_DEMO=true
DEMO_PASSWORD=ganti-password-demo
# API key uji untuk kelompok lain; format bebas, disarankan: dk_ + openssl rand -hex 16
SEED_API_KEY=dk_ganti-dengan-hasil-openssl-rand-hex-16
# ID akun pendonor@demo.test di auth (2 pada basis data baru)
DEMO_DONOR_USER_ID=2

# ===== Token =====
ACCESS_TOKEN_HOURS=12
REFRESH_TOKEN_DAYS=30

# ===== Gateway dan Cloudflare Tunnel =====
# Port gateway di STB (8080 sudah dipakai KatalogKu)
GATEWAY_PORT=8081
# Token tunnel dari Cloudflare (Networks > Tunnels > k02-donorkita). Isi hanya di .env STB.
TUNNEL_TOKEN=

# ===== Aturan kelayakan (Permenkes 91/2015; sesuaikan dengan UDD setempat) =====
DONATION_INTERVAL_DAYS=60
MAX_DONATIONS_PER_YEAR=5
DEFERRAL_DAYS=14
SCREENING_VALID_DAYS=30

# ===== Pencocokan =====
MATCH_RADIUS_STEPS_M=5000,10000,20000
REQUEST_MAX_DAYS_AHEAD=14

# ===== Stok darah =====
STOCK_LOW_UNITS=10
STOCK_CRITICAL_UNITS=3

# ===== Job latar belakang (kedaluwarsa permintaan, eskalasi radius) =====
ENABLE_JOBS=true
JOB_INTERVAL_SECONDS=30

# ===== Mock mode untuk demo (AGENTS.md bagian 7) =====
MOCK_MODE=false
MOCK_TICK_SECONDS=5
MOCK_TIME_SCALE=60
# MOCK_SEED=123
# Kunci untuk /api/_mock/scenario dan /api/_mock/state; buat dengan: openssl rand -hex 16
MOCK_ADMIN_API_KEY=
MOCK_DONORS=60
MOCK_DONOR_RECOVERY_MINUTES=10
MOCK_MAX_ACTIVE_REQUESTS=8

# ===== Hanya untuk menjalankan core tanpa auth-service (pengembangan di laptop) =====
# AUTH_INTERNAL_URL di-set otomatis oleh docker-compose; STATIC_API_KEYS dipakai bila kosong.
STATIC_API_KEYS=
