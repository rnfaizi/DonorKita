# Salin ke .env lalu isi nilainya. File .env tidak boleh di-commit.
# Buat secret dengan:  openssl rand -hex 32

# --- Basis data core (di dalam kontainer, pada volume Docker) ---
CORE_DB_PATH=/data/core.db

# --- Identitas & Akses ---
# Sama persis dengan JWT_SECRET di auth-service (Tahap 3)
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
# Diisi pada Tahap 3 saat auth-service sudah ada, contoh: http://auth:8000
AUTH_INTERNAL_URL=
INTERNAL_TOKEN=
# Hanya untuk pengembangan bila auth-service belum ada: daftar API key dipisah koma
STATIC_API_KEYS=

# --- Data uji (fasilitas, stok, dan kegiatan donor bertanda "Uji") ---
SEED_DEMO=true

# --- Aturan kelayakan (Permenkes 91/2015; sesuaikan dengan UDD setempat) ---
DONATION_INTERVAL_DAYS=60
MAX_DONATIONS_PER_YEAR=5
DEFERRAL_DAYS=14
SCREENING_VALID_DAYS=30

# --- Pencocokan ---
MATCH_RADIUS_STEPS_M=5000,10000,20000
REQUEST_MAX_DAYS_AHEAD=14

# --- Stok darah ---
STOCK_LOW_UNITS=10
STOCK_CRITICAL_UNITS=3

# --- Job latar belakang (kedaluwarsa permintaan, eskalasi radius) ---
ENABLE_JOBS=true
JOB_INTERVAL_SECONDS=30

# --- Mock mode untuk demo (AGENTS.md bagian 7, Tahap 3) ---
MOCK_MODE=false
MOCK_TICK_SECONDS=5
MOCK_TIME_SCALE=60
# MOCK_SEED=123   # isi untuk hasil yang dapat diulang; seed selalu dicatat di log saat start

# Variabel berikut ditambahkan pada tahap berikutnya:
# ADMIN_EMAIL, ADMIN_PASSWORD, SEED_API_KEY, MOCK_ADMIN_API_KEY (Tahap 3)
# TUNNEL_TOKEN, GATEWAY_PORT (Tahap 4)
